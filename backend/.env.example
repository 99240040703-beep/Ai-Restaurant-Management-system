# Copy to backend/.env and fill in your own values.

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=restaurant_db

# REQUIRED. Without this the backend refuses to start.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# =========================================================
# PAYMENTS
# =========================================================
# Two independent switches.
#
# PAYMENT_MODE   development - a local stand-in, no network, cannot move
#                               money. This is the default.
#                 test       - a real provider against Razorpay's
#                               sandbox. Real integration, no real money.
#                 live       - real provider, real money.
#                 disabled   - no payment requests at all.
#
# PAYMENT_PROVIDER   development | razorpay
#
# An unrecognised mode is treated as `disabled`, so a typo cannot
# accidentally enable something.
PAYMENT_MODE=development
PAYMENT_PROVIDER=development

# The UPI payee used by the development QR. demo@upi is not a real
# address and cannot receive money.
PAYMENT_MERCHANT_VPA=demo@upi
PAYMENT_MERCHANT_NAME=Paradise Restaurant
PAYMENT_NOTE_PREFIX=Paradise Restaurant order

# =========================================================
# RAZORPAY
# =========================================================
# LEAVE EMPTY unless you are deliberately integrating Razorpay.
#
# Test keys look like rzp_test_xxxxxxxx. Live keys look like
# rzp_live_xxxxxxxx. Keep them in the real .env file only - never in
# source, never in frontend/src, never in the database.
#
# With these empty the backend runs on the development provider and
# cannot take a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs incoming webhooks. Without it the backend refuses to start in
# test or live mode, because it could never confirm a payment.
RAZORPAY_WEBHOOK_SECRET=

# The live-money gate. PAYMENT_MODE=live does NOT take real money unless
# this is also true. See the long note in .env.
ALLOW_LIVE_PAYMENTS=false
